---

<section class="buttons" aria-labelledby="buttons-title">
  {
    images.map(({ href, src, title, alt }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        title={title}
        class="button-link"
      >
        <Image
          decoding="async"
          loading="eager"
          src={src}
          alt={alt}
          width="88"
          height="31"
        />
      </a>
    ))
  }
</section>

<style>
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;

    margin: 1rem auto;

    & a {
      display: inline-flex;
      line-height: 0;
    }

    & img {
      margin: auto 0;
      image-rendering: pixelated;
    }
  }
</style>
