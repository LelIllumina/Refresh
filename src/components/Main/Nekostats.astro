---
import FigureImage from "@components/FigureImage.astro";
---

<div id="views">
  <div id="views-counter">
    {
      Array.from({ length: 5 }).map((_, i) => (
        <FigureImage
          src={`/images/main/numbers/${i}.gif`}
          alt={String(i)}
          loading="lazy"
          decoding="async"
          caption={false}
          width={45}
          height={100}
        />
      ))
    }
    <span id="views-text" class="sr-only">00000</span>
    <p id="subtitle">Visits since creation</p>
  </div>

  <div id="stats">
    <h2>Stats:</h2>
    <p>
      <span id="created"><em>Created</em>: Loading...</span>
      <br />
      <span id="updated"><em>Updated</em>: Loading...</span>
      <br />
      <span id="followers"><em>Followers</em>: Loading...</span>
      <br />
    </p>
    <iframe
      loading="lazy"
      title="Nekoweb Follow button"
      src="https://nekoweb.org/frame/follow"
      width="150"
      height="35"
      style="border: none"></iframe>
  </div>
</div>
<script src="/src/scripts/main/nekostats.ts"></script>
<style>
  #views {
    div {
      margin: 1rem auto;
      padding-block: 0;

      figure {
        display: inline-block;
        image-rendering: pixelated;
      }
    }
  }
</style>
